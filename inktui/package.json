{
  "name": "inktui",
  "version": "0.0.0",
  "private": true,
  "description": "Ink (React-for-terminal) frontend for murder, using the shared application protocol client.",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "bin": {
    "inktui": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.dev.json src/index.tsx",
    "build": "tsc --build",
    "bundle": "npm --prefix .. run build -w @murder/ui-core && esbuild src/index.tsx --bundle --platform=node --format=esm --target=node20 --outfile=dist/bundle/index.js --alias:react-devtools-core=./stubs/react-devtools-core.js --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" && mkdir -p ../murder/_inktui && cp -f dist/bundle/index.js ../murder/_inktui/index.js",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "render-pane-fixture": "tsx --tsconfig tsconfig.dev.json fixtures/render-pane-fixture.ts",
    "fixtures:render": "tsx --tsconfig tsconfig.dev.json fixtures/render-pane-fixture.ts --all",
    "contracts:generate": "npm --prefix .. run protocol:generate",
    "contracts:check": "npm --prefix .. run protocol:check"
  },
  "dependencies": {
    "@murder/ui-core": "0.0.0",
    "@ink-tools/ink-mouse": "^2.1.0",
    "ink": "^7.0.5",
    "react": "19.2.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "string-width": "^8.2.2",
    "unified": "^11.0.5",
    "use-sync-external-store": "^1.6.0",
    "wrap-ansi": "^10.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
