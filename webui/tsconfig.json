{
  // Web frontend toolchain anchor. Mirrors ui-core's strictness so web-only code does not drift
  // below the shared package's bar. `bundler` resolution lets Vite/esbuild resolve the core's `.js`
  // specifiers to workspace TypeScript sources while developing.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // --- Output / target (browser) ---
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "sourceMap": true,

    // --- React ---
    "jsx": "react-jsx",

    // --- Strictness (match inktui/tsconfig.json) ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  // Include only browser sources and tests. Shared imports resolve from ui-core; Ink is never part
  // of this program.
  "include": ["src", "test", "vite.config.ts"]
}
